# Container reaches the published ports of your existing Docker Desktop services.
S3_ENDPOINT=http://host.docker.internal:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=banking-training
S3_PREFIX=banking/v3
PGHOST=host.docker.internal
PGPORT=5432
# Use an existing database and a user allowed to create schemas/tables.
PGDATABASE=banking_training
PGUSER=replace_with_your_postgres_user
PGPASSWORD=replace_with_your_postgres_password
